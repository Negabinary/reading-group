{
  "name": "mplse-reading-group",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --mode demo",
    "dev:live": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "npm run typecheck && vite build && npm run build:worker",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build:site": "tsc --noEmit && vite build",
    "build:legacy": "tsc --noEmit && node scripts/build-apps-script.mjs",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:github": "node scripts/setup-github.mjs",
    "preview:demo": "vite preview --host 127.0.0.1 --outDir dist/demo",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "node --import tsx --test tests/*.test.ts && vitest run",
    "test:worker": "node --import tsx --test tests/worker/*.test.ts",
    "check:search": "node --import tsx scripts/check-search.mjs",
    "check:api": "node scripts/check-api.mjs",
    "diagnose:api": "node --import tsx scripts/diagnose-api.mjs",
    "format": "prettier --write src worker apps-script scripts tests .github *.json *.ts *.html *.md",
    "format:check": "prettier --check src worker apps-script scripts tests .github *.json *.ts *.html *.md"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/google-apps-script": "^1.0.99",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "miniflare": "^5.20260915.0-alpha",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0"
  }
}
