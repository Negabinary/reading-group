{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mplse-reading-group",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/calendar.ics"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SHEET", "class_name": "SheetCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SheetCoordinator"] }],
  "observability": { "enabled": true }
}
